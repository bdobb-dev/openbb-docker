{
 "subscriptions": {
  "name": "Subscriptions",
  "description": "Manage the EODHD live subscription list: add and remove symbols, grouped by feed, against the 50-symbol budget. Symbols leased by kdb quotes are shown but expire on their own.",
  "category": "Live",
  "type": "iframe",
  "endpoint": "subscriptions",
  "gridData": {
   "w": 20,
   "h": 14
  }
 },
 "live_grid": {
  "name": "Live quotes",
  "description": "Real-time EODHD prices: US equities, crypto and forex in one watchlist. Type symbols into the widget.",
  "category": "Live",
  "type": "live_grid",
  "endpoint": "live_grid",
  "wsEndpoint": "live_grid_ws",
  "gridData": {
   "w": 40,
   "h": 12
  },
  "data": {
   "wsRowIdColumn": "symbol",
   "table": {
    "showAll": false,
    "columnsDefs": [
     {
      "field": "logo_url",
      "headerName": "",
      "renderFn": [
       "logo"
      ],
      "width": 32,
      "enableCellChangeWs": false,
      "pinned": "left"
     },
     {
      "field": "symbol",
      "width": 72,
      "headerName": "Symbol",
      "pinned": "left"
     },
     {
      "field": "price",
      "width": 88,
      "headerName": "Last",
      "renderFn": [
       "showCellChange"
      ],
      "renderFnParams": {
       "colorValueKey": "change"
      },
      "align": "right",
      "abbreviate": false
     },
     {
      "field": "change",
      "width": 84,
      "headerName": "Chg",
      "renderFn": [
       "greenRed"
      ],
      "align": "right",
      "abbreviate": false
     },
     {
      "field": "change_percent",
      "width": 84,
      "headerName": "% Chg",
      "renderFn": [
       "greenRed"
      ],
      "formatterFn": "normalizedPercent",
      "align": "right"
     },
     {
      "field": "rsi",
      "width": 116,
      "headerName": "RSI",
      "renderFn": ["rangeBar"],
      "renderFnParams": { "min": 0, "max": 100, "guides": [30, 50, 70], "bands": [30, 70] }
     },
     {
      "field": "avwap",
      "width": 88,
      "headerName": "VWAP",
      "headerTooltip": "The anchored VWAP itself, in price. Trade-true: the size-weighted mean of actual trades since VWAP Start, never a (H+L+C)/3 approximation. Blank when the symbol has no trade data in the window.",
      "enableCellChangeWs": false,
      "align": "right",
      "abbreviate": false
     },
     {
      "field": "avwap_dev",
      "width": 84,
      "headerName": "vs VWAP",
      "renderFn": ["rangeBar"],
      "renderFnParams": { "signed": true }
     },
     {
      "field": "vwap_start",
      "width": 80,
      "headerName": "Anchor",
      "headerTooltip": "Where the anchored VWAP starts. Type 10:00 for 10am your time every day, or a full date and time to pin it to one moment. Blank anchors at the UTC day start.",
      "editable": true,
      "enableCellChangeWs": false,
      "align": "center"
     },
     {
      "field": "day_low",
      "width": 84,
      "headerName": "Low",
      "enableCellChangeWs": false,
      "align": "right",
      "abbreviate": false
     },
     {
      "field": "day_range",
      "width": 64,
      "headerName": "Day",
      "renderFn": [
       "rangeBar"
      ],
      "renderFnParams": {
       "lowKey": "day_low",
       "highKey": "day_high",
       "palette": "day",
       "valueKey": "price"
      },
      "enableCellChangeWs": false
     },
     {
      "field": "day_high",
      "width": 84,
      "headerName": "High",
      "enableCellChangeWs": false,
      "align": "left",
      "abbreviate": false
     },
     {
      "field": "week52_low",
      "width": 84,
      "headerName": "Low",
      "enableCellChangeWs": false,
      "align": "right",
      "abbreviate": false
     },
     {
      "field": "week52_range",
      "width": 64,
      "headerName": "52 week",
      "renderFn": [
       "rangeBar"
      ],
      "renderFnParams": {
       "lowKey": "week52_low",
       "highKey": "week52_high",
       "palette": "week52",
       "valueKey": "price"
      },
      "enableCellChangeWs": false
     },
     {
      "field": "week52_high",
      "width": 84,
      "headerName": "High",
      "enableCellChangeWs": false,
      "align": "left",
      "abbreviate": false
     },
     {
      "field": "volume",
      "width": 88,
      "headerName": "Volume",
      "enableCellChangeWs": false
     },
     {
      "field": "bid",
      "width": 84,
      "headerName": "Bid",
      "hide": true
     },
     {
      "field": "ask",
      "width": 84,
      "headerName": "Ask",
      "hide": true
     },
     {
      "field": "last_size",
      "width": 80,
      "headerName": "Last Size",
      "hide": true
     },
     {
      "field": "updated_at",
      "width": 132,
      "headerName": "Updated",
      "hide": true
     },
     {
      "field": "day_open",
      "width": 88,
      "headerName": "Open",
      "hide": true
     }
    ]
   }
  },
  "params": [
   {
    "paramName": "symbol",
    "type": "text",
    "value": "AAPL,MSFT,TSLA,BTC-USD,ETH-USD,EURUSD",
    "label": "Symbols",
    "description": "Comma-separated watchlist: US equities (AAPL), crypto (BTC-USD), forex (EURUSD)",
    "multiSelect": true
   }
  ],
  "source": [
   "EODHD"
  ]
 },
 "kdb_ticks": {
  "name": "Tick History",
  "description": "Recent trades for one symbol out of the kdb+ tick cache. The cache is in-memory and holds a rolling day: a restarted kdb reads as empty.",
  "category": "Live",
  "type": "table",
  "endpoint": "ticks",
  "gridData": {
   "w": 20,
   "h": 12
  },
  "params": [
   {
    "paramName": "symbol",
    "value": "AAPL",
    "label": "Symbol",
    "type": "text"
   },
   {
    "paramName": "limit",
    "value": "200",
    "label": "Rows",
    "type": "number"
   }
  ],
  "data": {
   "dataKey": "ticks",
   "table": {
    "showAll": false,
    "columnsDefs": [
     {
      "field": "time",
      "headerName": "Time",
      "cellDataType": "text"
     },
     {
      "field": "price",
      "headerName": "Price"
     },
     {
      "field": "size",
      "headerName": "Size"
     }
    ]
   }
  },
  "source": [
   "kdb+"
  ]
 },
 "kdb_cache_chart": {
  "name": "Cached Price Chart",
  "description": "Historical prices served through the kdb+ read-through cache, joined to live tick-derived bars",
  "category": "Equity",
  "type": "chart",
  "endpoint": "chart",
  "gridData": {
   "w": 20,
   "h": 12
  },
  "params": [
   {
    "paramName": "symbol",
    "value": "AAPL",
    "label": "Symbol",
    "type": "text"
   },
   {
    "paramName": "interval",
    "value": "1d",
    "label": "Interval",
    "type": "text",
    "options": [
     {
      "label": "1 day",
      "value": "1d"
     },
     {
      "label": "1 hour",
      "value": "1h"
     },
     {
      "label": "5 min",
      "value": "5m"
     }
    ]
   }
  ]
 },
