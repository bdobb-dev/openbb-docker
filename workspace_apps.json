              "calendarView": {
                "enabled": true,
                "mode": "paged",
                "unit": "month",
                "evenRows": true
              }
            }
          },
          {
            "i": "fixedincome_government_treasury_auctions_government_us_obb",
            "x": 0,
            "y": 24,
            "w": 20,
            "h": 18,
            "state": {
              "params": {
                "provider": "government_us"
              },
              "chartView": {
                "enabled": false,
                "chartType": "line"
              },
              "calendarView": {
                "enabled": true,
                "mode": "vertical",
                "rowUnit": "week"
              }
            }
          },
          {
            "i": "equity_calendar_earnings_eodhd_obb",
            "x": 20,
            "y": 24,
            "w": 20,
            "h": 18,
            "state": {
              "params": {
                "provider": "eodhd"
              },
              "chartView": {
                "enabled": false,
                "chartType": "line"
              },
              "calendarView": {
                "enabled": true,
                "mode": "horizontal",
                "cellMode": "list",
                "seriesField": "symbol",
                "series": [
                  "AAPL.US",
                  "MSFT.US",
                  "NVDA.US",
                  "AMZN.US",
                  "GOOGL.US",
                  "META.US",
                  "TSLA.US"
                ]
              }
            }
          }
        ]
