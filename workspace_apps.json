[
  {
    "name": "Example Dashboard - Version 8.0.0",
    "description": "The v8.0.0 News widget on its own: one full-size card in the vertical layout, subscribed through an rss-ticker server to fourteen feeds under Wires, Substack, Seeking Alpha and Satire tabs, with Fed headlines highlighted. The card opens asking for the server — enter your rss-ticker URL in Parameters and the feeds start; change them from the card menu's Configure feeds…. Needs a reachable rss-ticker server; nothing here is served by an OpenBB backend.",
    "img": "",
    "img_dark": "",
    "img_light": "",
    "allowCustomization": true,
    "tabs": {
      "news": {
        "id": "news",
        "name": "RSS Aggregator",
        "layout": [
          {
            "i": "news",
            "x": 0,
            "y": 0,
            "w": 40,
            "h": 40,
            "state": {
              "params": {
                "url": "",
                "layout": "vertical",
                "autoScroll": "off"
              },
              "news": {
                "feeds": [
                  {
                    "url": "https://feeds.bloomberg.com/markets/news.rss",
                    "name": "Bloomberg",
                    "tab": "Wires"
                  },
                  {
                    "url": "https://feeds.content.dowjones.io/public/rss/RSSMarketsMain",
                    "name": "WSJ Markets",
                    "tab": "Wires"
                  },
                  {
                    "url": "https://rss.nytimes.com/services/xml/rss/nyt/Business.xml",
                    "name": "NYT Business",
                    "tab": "Wires"
                  },
                  {
                    "url": "https://www.ft.com/markets?format=rss",
                    "name": "FT Markets",
                    "tab": "Wires"
                  },
                  {
                    "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=100003114",
                    "name": "CNBC",
                    "tab": "Wires"
                  },
                  {
                    "url": "https://news.google.com/rss/search?q=site:reuters.com+when:1d&hl=en-US&gl=US&ceid=US:en",
                    "name": "Reuters",
                    "tab": "Wires"
                  },
                  {
                    "url": "https://bobpisani.substack.com/feed",
                    "name": "Bob Pisani",
                    "tab": "Substack"
                  },
                  {
                    "url": "https://dimartinobooth.substack.com/feed",
                    "name": "Danielle DiMartino Booth",
                    "tab": "Substack"
                  },
                  {
                    "url": "https://peterboockvar.substack.com/feed",
                    "name": "Peter Boockvar",
                    "tab": "Substack"
