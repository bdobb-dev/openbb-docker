        "name": "Markets",
        "layout": [
          {
            "i": "equity_price_historical_eodhd_obb",
            "x": 0,
            "y": 0,
            "w": 20,
            "h": 12,
            "groups": [
              "Symbol",
              "Interval"
            ],
            "state": {
              "params": {
