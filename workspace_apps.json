              "chartView": {
                "enabled": false,
                "chartType": "line"
              }
            }
          },
          {
            "i": "equity_price_historical_eodhd_obb",
            "x": 20,
            "y": 0,
            "w": 20,
            "h": 12,
            "groups": [
              "Symbol",
              "Interval"
            ],
            "state": {
              "params": {
                "symbol": "AAPL",
                "interval": "1d",
                "provider": "eodhd"
              },
              "chartView": {
                "enabled": true,
                "chartType": "candlestick"
              }
            }
          },
          {
            "i": "equity_fundamental_income_eodhd_obb",
            "x": 0,
            "y": 12,
            "w": 40,
            "h": 12,
            "groups": [
              "Symbol"
            ],
            "state": {
              "params": {
                "symbol": "AAPL",
