                "provider": "eodhd"
              },
              "chartView": {
                "enabled": false,
                "chartType": "line"
              }
            }
          }
        ]
      },
      "calendars": {
        "id": "calendars",
        "name": "Calendars",
        "layout": [
          {
            "i": "economy_calendar_eodhd_obb",
            "x": 0,
            "y": 0,
            "w": 40,
            "h": 24,
            "state": {
              "params": {
                "country": "US",
