# HTTP Basic auth for the OpenBB Platform API — copy to `api-auth.env`:
#   cp api-auth.env.example api-auth.env && chmod 600 api-auth.env
#
# REQUIRED from v2.0.0 on: the compose file refuses to start the API without
# this file, ON PURPOSE. Tailscale Funnel can expose port 443 to the public
# internet, and there must be no configuration in which the public door
# exists and the lock doesn't. (Lock first, then door — see Ep. 2.)
#
# Pick a strong password. Clients send it as an Authorization header:
#   Authorization: Basic <base64 of username:password>
OPENBB_API_AUTH=true
OPENBB_API_USERNAME=openbb
OPENBB_API_PASSWORD=
