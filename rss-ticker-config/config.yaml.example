# rss-ticker config for the openbb-docker stack (Adventures in OpenBB, Ep. 8).
#
# The ticker sits on this stack's private openbb-internal bridge, so it uses
# manifest_key + per-user tokens rather than tailscale_auth.
#
# Why not tailscale_auth: that mode trusts the Tailscale-User-Login header
# Serve injects, which is only sound when Serve is the ONLY thing that can
# reach the port — so rss-ticker refuses to start under tailscale_auth unless
# bind_host is loopback. On a shared bridge, any container attached to
# openbb-internal could connect straight to :8088 and forge that header. The
# manifest key gates widgets.json (it is what you paste into Workspace), and
# each user authenticates with their own token.
#
#   cp config.yaml.example config.yaml   # then edit the tailnet name & feeds

public_base_url: https://openbb.<your-tailnet>.ts.net:8088

# Writes on /api/feeds and per-feed health detail. Comes from rss-ticker.env.
admin_key: ${TICKER_ADMIN_KEY}

# Gates widgets.json; this is the value pasted into Workspace/BDOBB as the
# backend's API key. MUST differ from admin_key.
manifest_key: ${TICKER_MANIFEST_KEY}

# 0.0.0.0 here means the openbb-internal bridge, not the LAN: no ports are
# published, so nothing off this Docker host can reach it.
bind_host: 0.0.0.0

retention_days: 7
default_poll_interval_s: 300
max_concurrent_polls: 8

# Be judicious with poll intervals: publishers monitor, and an over-eager
# poller gets throttled or disconnected -- sometimes mistaken for an attack.
# Conditional GETs make polite polling cheap; they don't make rude polling safe.
users:
  - id: art
    name: Art
    # Per-user token, at least 32 characters. Generate with:
    #   python -c "import secrets; print(secrets.token_urlsafe(32))"
    token: ${TICKER_USER_TOKEN_ART}
    feeds:
      - {url: "https://feeds.bloomberg.com/markets/news.rss", name: Bloomberg Markets, group: Markets, poll_interval_s: 90}
      - {url: "https://feeds.content.dowjones.io/public/rss/RSSMarketsMain", name: WSJ Markets, group: Markets, poll_interval_s: 90}
      # NYT sends no cache validators, so every poll re-downloads; its CDN
      # caches 5 minutes anyway — a faster interval buys no freshness.
      - {url: "https://rss.nytimes.com/services/xml/rss/nyt/Business.xml", name: NYT Business, group: Markets, poll_interval_s: 300}
      - {url: "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=100003114", name: CNBC, group: CNBC, poll_interval_s: 30}
      # Substack works like any RSS feed; title_format adds the byline.
      - url: "https://bobpisani.substack.com/feed"
        name: Bob Pisani
        group: Substack
        title_format: "{title} - {author}"
    filters:
      - {pattern: nvidia, action: highlight}
