# rss-ticker config for the openbb-docker stack (Adventures in OpenBB, Ep. 8,
# reworked for BDOBB v8.0.0).
#
# With the reworked rss-ticker 8.0.0 this is a user-agnostic shared feed pool: BDOBB's
# News widget subscribes feed URLs over the websocket, and nothing here names
# a feed, a user or a key. The server refuses to start on any other key.
#
#   cp config.yaml.example config.yaml

# Articles a feed no longer lists are kept this long after they were last seen.
retention_days: 7

# Every feed polls at this interval. Be judicious: publishers monitor, and an
# over-eager poller gets throttled or disconnected. 90 suits a pool of wires;
# 300 suits blogs and newsletters.
default_poll_interval_s: 90

max_concurrent_polls: 8

# 0.0.0.0 on the openbb-internal bridge: nothing is published to the host, and
# the bridge is what decides who can reach the port. There is no authentication.
bind_host: 0.0.0.0
