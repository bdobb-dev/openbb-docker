# obb-up — one-command wrapper around docker compose for the OpenBB stack.
#
#   ./obb-up            # launch the interactive OpenBB Terminal (default)
#   ./obb-up api        # start the REST API server (http://localhost:6900)
#   ./obb-up shell      # drop into a bash shell in the OpenBB container
#   ./obb-up status     # show all stack containers
#   ./obb-up down       # stop everything (data volumes are kept)
#
set -e
cd "$(dirname "$0")"

cmd="${1:-terminal}"
case "$cmd" in
  api)
    docker compose --profile api up -d openbb-api
    echo "OpenBB REST API: http://localhost:6900/docs"
    ;;
  terminal)
    docker compose run --rm openbb
    ;;
  shell)
    docker compose run --rm openbb bash
    ;;
  status|ps)
    docker compose --profile api ps
    ;;
  down)
    docker compose --profile api down
    ;;
  -h|--help|help)
    sed -n '2,16p' "$0"
    ;;
  *)
    echo "unknown command: $cmd" >&2
    echo "usage: ./obb-up [terminal|api|shell|status|down]" >&2
    exit 1
    ;;
esac
