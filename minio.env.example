# MinIO credentials and the Delta Lake connection derived from them (Ep. 11).
#   cp minio.env.example minio.env && chmod 600 minio.env
#
# IMPORTANT: keep comments on their OWN lines. Compose's dotenv parser treats
# an inline "# comment" after an empty value as the value itself.

# --- MinIO root credentials. Set a strong password. ---
# This is the ROOT/ADMIN credential, not a scoped one -- it also logs into
# the MinIO console on :9001, reachable by every tailnet peer. A
# bucket-scoped key would be better posture; using root here is a
# deliberate trade-off to keep setup to one credential.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Where Delta Lake finds the store ---
# Your tailnet's name, e.g. minio.tailXXXXXX.ts.net -- MagicDNS must be on.
DELTA_S3_ENDPOINT=
DELTA_S3_PORT=9000
DELTA_S3_BUCKET=openbb
DELTA_S3_SECURE=true
# These MUST match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above.
DELTA_S3_ACCESS=
DELTA_S3_SECRET=
# Delta library used by the provider. The tick-lab loader writes its own.
DELTA_LIBRARY=openbb

# --- Same store, combined-URI form ---
# openbb-deltalake falls back to this single URI when the split DELTA_S3_*
# vars above aren't set (see openbb_deltalake/utils.py). A path or an s3:// URL;
# credentials travel as storage_options, never in the URI.
DELTA_URI=

# ---------------------------------------------------------------------------
# Episode 15 tiered storage (tick-vault)
# ---------------------------------------------------------------------------
# Two MinIO instances, split by access pattern rather than by medallion layer:
#
#   HOT  = the `minio` service above (NVMe mirror, on the tailnet over TLS).
#          Small tables read on EVERY item of the 262k-item backfill walk,
#          plus gold and the ops receipts.
#   COLD = the `minio-hdd` service (HDD raidz1, internal network, plain HTTP).
#          Bronze captures and the ~19.6 TB of silver tick history.
#
# tick_vault/storage.py's TIER_BY_TABLE is the authoritative routing policy;
# moving a table between tiers is a one-line edit there. Leave every variable
# below EMPTY to keep tick-vault entirely on local disk under VAULT_ROOT,
# which is what the test suite and a local `vault calibrate` run use.

# --- Hot tier: the SAME endpoint openbb-api already uses. -------------------
# NOTE: this is https:// on the tailnet MagicDNS name, NOT http://minio:9000.
# The `minio` service is a Tailscale node that terminates TLS with a
# certificate issued for its own MagicDNS name, so a plaintext or
# container-alias endpoint fails (connection or hostname verification).
DELTA_S3_HOT_ENDPOINT=            # https://minio.<your-tailnet>.ts.net:9000
DELTA_S3_HOT_ACCESS_KEY=          # = MINIO_ROOT_USER
DELTA_S3_HOT_SECRET_KEY=          # = MINIO_ROOT_PASSWORD
DELTA_S3_HOT_REGION=us-east-1
DELTA_S3_HOT_ALLOW_HTTP=false

# --- Cold tier: reached by container alias on openbb-internal. --------------
DELTA_S3_COLD_ENDPOINT=http://minio-hdd:9000
DELTA_S3_COLD_ACCESS_KEY=         # = MINIO_ROOT_USER
DELTA_S3_COLD_SECRET_KEY=         # = MINIO_ROOT_PASSWORD
DELTA_S3_COLD_REGION=us-east-1
DELTA_S3_COLD_ALLOW_HTTP=true

# --- Tier -> bucket. The bucket IS the layer; no layer prefix in the key. ---
LAKE_BRONZE_URI=s3://bronze           # cold
LAKE_SILVER_URI=s3://silver           # cold  (us_trade_tick_version, the bulk)
LAKE_SILVER_HOT_URI=s3://silver-hot   # hot   (instrument, listing, membership...)
LAKE_GOLD_URI=s3://gold               # hot
LAKE_RECEIPTS_URI=s3://receipts       # hot   (ops.* manifest / DQ / runs)

# --- Host paths for the data these services actually hold. -----------------
# COLD_DATA_DIR backs minio-hdd (the 19.6 TB). REQUIRED to start minio-hdd.
COLD_DATA_DIR=                    # e.g. /share/ZFS1684_DATA/minio-hdd
# VAULT_DATA_DIR backs <VAULT_ROOT>/_payloads, which tiering does NOT move
# off local disk (capture.write_payload is plain POSIX). Unset = the Docker
# named volume, which is the ~99 GB storage pool: too small for a real walk.
VAULT_DATA_DIR=                   # e.g. /share/ZFS1684_DATA/tick-vault
