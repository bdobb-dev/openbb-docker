# MinIO credentials and the Delta Lake connection derived from them (Ep. 11).
#   cp minio.env.example minio.env && chmod 600 minio.env
#
# IMPORTANT: keep comments on their OWN lines. Compose's dotenv parser treats
# an inline "# comment" after an empty value as the value itself.

# --- MinIO root credentials. Set a strong password. ---
# This is the ROOT/ADMIN credential, not a scoped one -- it also logs into
# the MinIO console on :9001, reachable by every tailnet peer. A
# bucket-scoped key would be better posture; using root here is a
# deliberate trade-off to keep setup to one credential.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Where Delta Lake finds the store ---
# Your tailnet's name, e.g. minio.tailXXXXXX.ts.net -- MagicDNS must be on.
DELTA_S3_ENDPOINT=
DELTA_S3_PORT=9000
DELTA_S3_BUCKET=openbb
DELTA_S3_SECURE=true
# These MUST match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above.
DELTA_S3_ACCESS=
DELTA_S3_SECRET=
# Delta library used by the provider. The tick-lab loader writes its own.
DELTA_LIBRARY=openbb

# --- Same store, combined-URI form ---
# openbb-deltalake falls back to this single URI when the split DELTA_S3_*
# vars above aren't set (see openbb_deltalake/utils.py). A path or an s3:// URL;
# credentials travel as storage_options, never in the URI.
DELTA_URI=

# ---------------------------------------------------------------------------
# Episode 15 tiered storage (tick-vault)
# ---------------------------------------------------------------------------
# Two MinIO instances, split by ACCESS PATTERN rather than by medallion layer:
#
#   HOT  = the `minio` service above (NVMe, on the tailnet over TLS). The small
#          tables read on EVERY item of the 262k-item backfill walk, plus gold
#          and the ops receipts.
#   COLD = the `minio-hdd` service (HDD raidz1, internal network, plain HTTP).
#          Bronze captures and the ~19.6 TB of silver tick history.
#
# tick_vault/storage.py's TIER_BY_TABLE is the authoritative routing policy;
# moving a table between tiers is a one-line edit there.
#
# LEAVE EVERY VALUE BELOW EMPTY to keep tick-vault on local disk under
# VAULT_ROOT -- that is the shipped default, and what the test suite and a
# local `vault calibrate` run use. Values are documented per key; put them in
# your real minio.env, never here (this template is gated to empty values).
#
# NOTE: no inline `# comment` after a value in your real minio.env either --
# the whole rest of the line is read as the value, comment included.

# --- Hot tier ---------------------------------------------------------------
# Use the SAME endpoint openbb-api already uses: https:// on the tailnet
# MagicDNS name, port 9000. NOT http://minio:9000 -- the hot store is a
# Tailscale node terminating TLS with a certificate issued for its own
# MagicDNS name, so plaintext or a container alias fails outright.
DELTA_S3_HOT_ENDPOINT=
# Both = MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above.
DELTA_S3_HOT_ACCESS_KEY=
DELTA_S3_HOT_SECRET_KEY=
# us-east-1 (MinIO ignores it, but delta-rs requires one).
DELTA_S3_HOT_REGION=
# false -- the hot tier is TLS.
DELTA_S3_HOT_ALLOW_HTTP=

# --- Cold tier --------------------------------------------------------------
# Reached by container alias on openbb-internal: http://minio-hdd:9000
DELTA_S3_COLD_ENDPOINT=
DELTA_S3_COLD_ACCESS_KEY=
DELTA_S3_COLD_SECRET_KEY=
# us-east-1
DELTA_S3_COLD_REGION=
# true -- the cold tier is plain HTTP on the internal network only.
DELTA_S3_COLD_ALLOW_HTTP=

# --- Tier -> bucket. The bucket IS the layer; no layer prefix in the key. ---
# Suggested values, all on their own store:
#   LAKE_BRONZE_URI      s3://bronze      (cold)
#   LAKE_SILVER_URI      s3://silver      (cold -- us_trade_tick_version, bulk)
#   LAKE_SILVER_HOT_URI  s3://silver-hot  (hot  -- instrument, listing, ...)
#   LAKE_GOLD_URI        s3://gold        (hot)
#   LAKE_RECEIPTS_URI    s3://receipts    (hot  -- ops.* manifest / DQ / runs)
LAKE_BRONZE_URI=
LAKE_SILVER_URI=
LAKE_SILVER_HOT_URI=
LAKE_GOLD_URI=
LAKE_RECEIPTS_URI=

# --- Host paths for the data these services actually hold. ------------------
# COLD_DATA_DIR backs minio-hdd (the ~19.6 TB). Point it at a directory on the
# big array; unset, minio-hdd falls back to a named volume on the Docker
# storage pool, which is far too small for a real walk.
COLD_DATA_DIR=
# VAULT_DATA_DIR backs <VAULT_ROOT>/_payloads, which tiering does NOT move off
# local disk (capture.write_payload is plain POSIX). Same size warning: unset
# means the Docker storage pool.
VAULT_DATA_DIR=
