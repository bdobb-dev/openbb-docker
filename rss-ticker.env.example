# rss-ticker secrets for the openbb-docker stack.
#   cp rss-ticker.env.example rss-ticker.env && chmod 600 rss-ticker.env
# Generate each: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Three distinct values. The ticker runs in manifest_key mode on this stack's
# private bridge -- see rss-ticker-config/config.yaml.example for why it is not
# tailscale_auth -- so the manifest key and per-user tokens are real, not
# replaced by an injected identity.

# Writes on /api/feeds and per-feed health detail.
TICKER_ADMIN_KEY=

# Gates widgets.json; pasted into Workspace/BDOBB as the backend API key.
# MUST differ from TICKER_ADMIN_KEY -- the app refuses to start otherwise.
TICKER_MANIFEST_KEY=

# Per-user token, at least 32 characters. One per user in config.yaml.
TICKER_USER_TOKEN_ART=
