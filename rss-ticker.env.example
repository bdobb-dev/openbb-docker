# rss-ticker secrets for the openbb-docker stack.
#   cp rss-ticker.env.example rss-ticker.env && chmod 600 rss-ticker.env
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Only the admin key is needed here: under tailscale_auth the manifest key
# and per-user tokens are replaced by the identity Tailscale Serve injects.
TICKER_ADMIN_KEY=
