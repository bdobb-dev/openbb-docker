      "kind": "standard",
      "model_id": "EquityInfo",
      "parameters": [
        {
          "description": "Ticker or historical alias",
          "name": "symbol",
          "required": true,
          "type": "string"
        }
      ],
      "primary_temporal_scenario": "shares_outstanding",
      "resolve": "symbol",
      "route": "/api/v1/equity/profile",
      "sql": "SELECT symbol, name, shares_outstanding, period_end, filing_kind, currency, mic, listing_id, assertion_id, capture_id, shares_assertion_id, shares_capture_id FROM gold.odp_equity_info WHERE listing_id = $listing_id",
      "temporal_capabilities": [
        "current_corrected",
        "effective_on",
        "known_at"
      ]
    },
    {
      "backing_relation": "gold.security_master",
      "consumers": [
        "bdobb-v2 security master browser",
        "obb.equity.search"
      ],
      "fields": [
        {
          "name": "symbol",
          "source": "gold.security_master.symbol",
          "type": "string"
        },
        {
          "name": "name",
          "source": "gold.security_master.name",
          "type": "string"
        },
        {
          "name": "listing_id",
          "source": "gold.security_master.listing_id",
          "type": "string"
        },
        {
          "name": "mic",
          "source": "gold.security_master.mic",
          "type": "string"
        }
      ],
      "kind": "standard",
      "model_id": "EquitySearch",
      "parameters": [
        {
          "description": "Symbol or name fragment",
          "name": "query",
          "required": true,
          "type": "string"
        }
      ],
      "primary_temporal_scenario": "ticker_change",
      "route": "/api/v1/equity/search",
      "sql": "SELECT symbol, name, listing_id, mic, instrument_id, assertion_id, capture_id FROM gold.security_master WHERE upper(symbol) LIKE upper($query) || '%' OR upper(name) LIKE '%' || upper($query) || '%' ORDER BY symbol LIMIT 100",
      "temporal_capabilities": [
        "current_corrected",
        "effective_on"
      ]
    },
    {
