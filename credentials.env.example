# OpenBB provider API keys — copy this file to `credentials.env` and fill in.
#   cp credentials.env.example credentials.env
# It is injected into the container via docker-compose (env_file). OpenBB reads
# these bare UPPERCASE names directly into its credentials; empty values are
# ignored, so you only need the providers you use.
#
# IMPORTANT: keep comments on their OWN lines. Compose's dotenv parser treats
# an inline "# comment" after an empty value as the value itself.
#
# Keyless providers need nothing here at all:
# yfinance, sec, federal_reserve, oecd, imf, ecb, finviz, ...

# --- Common free-tier providers ---
# financialmodelingprep.com (free tier)
FMP_API_KEY=
# fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# tiingo.com (free token)
TIINGO_TOKEN=
# alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# data.nasdaq.com (Nasdaq Data Link)
NASDAQ_API_KEY=
# eia.gov/opendata/register.php
EIA_API_KEY=
# data.bls.gov/registrationEngine
BLS_API_KEY=
# publicreporting.cftc.gov (Socrata app token)
CFTC_APP_TOKEN=
# api.congress.gov/sign-up
CONGRESS_GOV_API_KEY=
# econdb.com (optional; works keyless with limits)
ECONDB_API_KEY=
# rapidapi.com biztoc
BIZTOC_API_KEY=

# --- Paid / premium providers ---
INTRINIO_API_KEY=
BENZINGA_API_KEY=
TRADINGECONOMICS_API_KEY=

# --- Brokerage (Tradier) ---
TRADIER_API_KEY=
# "sandbox" or "live"
TRADIER_ACCOUNT_TYPE=
