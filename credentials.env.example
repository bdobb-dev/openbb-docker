# OpenBB provider API keys — copy this file to `credentials.env` and fill in.
#   cp credentials.env.example credentials.env
# It is injected into the container via docker-compose (env_file). OpenBB reads
# these bare UPPERCASE names directly into its credentials; empty values are
# ignored, so you only need the providers you use.
#
# IMPORTANT: keep comments on their OWN lines. Compose's dotenv parser treats
# an inline "# comment" after an empty value as the value itself.
#
# Keyless providers need nothing here at all:
# yfinance, sec, federal_reserve, oecd, imf, ecb, finviz, ...

# --- Common free-tier providers ---
# financialmodelingprep.com (free tier)
FMP_API_KEY=
# fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# tiingo.com (free token)
TIINGO_TOKEN=
# alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# data.nasdaq.com (Nasdaq Data Link)
NASDAQ_API_KEY=
# eia.gov/opendata/register.php
EIA_API_KEY=
# data.bls.gov/registrationEngine
BLS_API_KEY=
# publicreporting.cftc.gov (Socrata app token)
CFTC_APP_TOKEN=
# api.congress.gov/sign-up
CONGRESS_GOV_API_KEY=
# econdb.com (optional; works keyless with limits)
ECONDB_API_KEY=
# rapidapi.com biztoc
BIZTOC_API_KEY=

# --- Paid / premium providers ---
INTRINIO_API_KEY=
BENZINGA_API_KEY=
TRADINGECONOMICS_API_KEY=

# --- Brokerage (Tradier) ---
TRADIER_API_KEY=
# "sandbox" or "live"
TRADIER_ACCOUNT_TYPE=

# --- EODHD (custom provider + live-grid, Ep. 9) ---
# The public demo websocket key (from EODHD's docs and the official SDK's
# demo code — safe to commit) covers ONLY these symbols, which are exactly
# live-grid's default watchlist: AAPL, MSFT, TSLA, BTC-USD, ETH-USD, EURUSD.
# For real watchlists use your own eodhd.com token; websockets need a paid
# plan (free-tier keys 403 on connect).
EODHD_API_KEY=OeAFFmMliFG5orCUuwAKQ8l4WWFQ67YX

# --- kdb+ (Ep. 10) ---------------------------------------------------------
# Where the cache finds q. Two ways, tried in this order:
#
#   1. Drop your own q into ./kdb (see kdb/README.md) and it is used directly.
#   2. Run your own kdb container and point KDB_HOST at it.
#
# KDB_HOST is only needed for option 2. The value differs by platform:
#   Docker Desktop (macOS/Windows):  host.docker.internal
#   Linux host:                      172.17.0.1   (your docker0 gateway)
#
# Run your container so q listens on 0.0.0.0 INSIDE it and publish it to host
# loopback only:
#
#   docker run -d --name my-kdb -p 127.0.0.1:5000:5000 <your image>
#
# Both halves matter. A 127.0.0.1 bind inside the container is unreachable
# through -p (verified: the q handshake fails), and publishing to 0.0.0.0 on
# the host puts an unauthenticated q -- which executes arbitrary q -- on your
# LAN.
KDB_HOST=
KDB_PORT=5000
