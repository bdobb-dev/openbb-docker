# secrets & machine-specific config — never committed
credentials.env
api-auth.env
ts.env
minio.env
rss-ticker.env
deps.env
.env
.env.*
scripts/scrub-private-patterns.txt

# runtime state
ts-state/
ts-state-minio/
kdb-data/
live-grid-data/
*.log

# kdb+ license -- bring your own; never commit it.
kdb-license/*
!kdb-license/.gitkeep

# The operator's own q binary -- bring your own; never commit it.
# Enforced by kdb/.gitignore itself (belt and suspenders: this directory
# must be structurally impossible to commit a binary into).

# python
__pycache__/
*.egg-info/
.pytest_cache/
.venv/

# Finder metadata
.DS_Store

# superpowers session scratch (progress ledger, briefs, review packages)
.superpowers/

# widget smoke-test output: a live snapshot, regenerate rather than commit
scripts/widget_smoke/output/
eod.env
